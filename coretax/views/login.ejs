<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - CoreTax e-Faktur</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="login-wrapper">
    <div class="login-box">
      <div style="text-align:center; margin-bottom:20px;">
        <img src="/images/logo.png" alt="Logo" onerror="this.style.display='none'" style="max-height:60px; max-width:100%;">
      </div>
      <h2>CoreTax e-Faktur</h2>
      <p style="text-align:center; color:#7f8c8d; margin-bottom:20px; font-size:14px;">
        Login dengan user Adempiere
      </p>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form action="/login" method="POST">
        <div class="form-group">
          <label for="username">Username</label>
          <input type="text" id="username" name="username" required autofocus>
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required>
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%;">Login</button>
      </form>
    </div>
  </div>
</body>
</html>
