<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - CoreTax Generator</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="navbar-inner">
      <div class="navbar-brand">
        <img src="/images/logo.png" alt="Logo" onerror="this.style.display='none'">
        CoreTax Generator
      </div>
      <div class="navbar-links">
        <a href="/dashboard">Dashboard</a>
        <a href="/faktur">Faktur PPN</a>
        <a href="/login/logout">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container">
    <h2 style="margin-bottom: 20px;">Selamat datang, <%= userName %></h2>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="card">
      <form method="GET" action="/dashboard">
        <div class="filter-bar">
          <div class="form-group">
            <label>Periode</label>
            <input type="month" name="periode" value="<%= periode %>">
          </div>
          <button type="submit" class="btn btn-primary">Tampilkan</button>
          <a href="/dashboard" class="btn" style="background:#95a5a6;color:#fff;">Reset</a>
        </div>
      </form>
    </div>

    <div class="stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
      <div class="stat-card">
        <div class="stat-value"><%= totalKeluaran %></div>
        <div class="stat-label">Keluaran — <%= periodeLabel %></div>
      </div>
      <div class="stat-card">
        <div class="stat-value"><%= totalMasukan %></div>
        <div class="stat-label">Masukan — <%= periodeLabel %></div>
      </div>
    </div>

    <div class="card">
      <h3 style="margin-bottom: 16px;">Menu Cepat</h3>
      <a href="/faktur?tipe=keluaran" class="btn btn-primary">Faktur PPN Keluaran</a>
      <a href="/faktur?tipe=masukan" class="btn btn-primary" style="margin-left:8px;">Faktur PPN Masukan</a>
    </div>
  </div>

  <div class="footer">
    CoreTax Generator App &copy; <%= new Date().getFullYear() %>
  </div>
</body>
</html>
