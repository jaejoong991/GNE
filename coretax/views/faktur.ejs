<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= config.label %> - CoreTax e-Faktur</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .tabs {
      display: flex;
      border-bottom: 2px solid #ddd;
      margin-bottom: 20px;
    }
    .tab {
      padding: 12px 24px;
      text-decoration: none;
      color: #7f8c8d;
      font-weight: 600;
      border-bottom: 2px solid transparent;
      margin-bottom: -2px;
    }
    .tab.active {
      color: #3498db;
      border-bottom-color: #3498db;
    }
    .tab:hover {
      color: #3498db;
    }
  </style>
</head>
<body>
  <nav class="navbar">
    <div class="navbar-inner">
      <div class="navbar-brand">
        <img src="/images/logo.png" alt="Logo" onerror="this.style.display='none'">
        CoreTax e-Faktur
      </div>
      <div class="navbar-links">
        <a href="/dashboard">Dashboard</a>
        <a href="/faktur">Faktur PPN</a>
        <a href="/login/logout">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container">
    <div class="tabs">
      <a href="/faktur?tipe=keluaran<%= start ? '&start=' + start : '' %><%= end ? '&end=' + end : '' %><%= nomor_faktur ? '&nomor_faktur=' + encodeURIComponent(nomor_faktur) : '' %><%= customer ? '&customer=' + encodeURIComponent(customer) : '' %>"
         class="tab <%= tipe === 'keluaran' ? 'active' : '' %>">
        PPN Keluaran
      </a>
      <a href="/faktur?tipe=masukan<%= start ? '&start=' + start : '' %><%= end ? '&end=' + end : '' %><%= nomor_faktur ? '&nomor_faktur=' + encodeURIComponent(nomor_faktur) : '' %><%= customer ? '&customer=' + encodeURIComponent(customer) : '' %>"
         class="tab <%= tipe === 'masukan' ? 'active' : '' %>">
        PPN Masukan
      </a>
    </div>

    <h2 style="margin-bottom: 20px;"><%= config.label %></h2>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="card">
      <form method="GET" action="/faktur">
        <input type="hidden" name="tipe" value="<%= tipe %>">
        <div class="filter-bar">
          <div class="form-group">
            <label>Dari Tanggal</label>
            <input type="date" name="start" value="<%= start %>">
          </div>
          <div class="form-group">
            <label>Sampai Tanggal</label>
            <input type="date" name="end" value="<%= end %>">
          </div>
          <div class="form-group">
            <label>Nomor Faktur</label>
            <input type="text" name="nomor_faktur" value="<%= nomor_faktur %>" placeholder="%1000236">
          </div>
          <div class="form-group">
            <label><%= config.partnerLabel %></label>
            <input type="text" name="customer" value="<%= customer %>" placeholder="%nama">
          </div>
          <button type="submit" class="btn btn-primary">Filter</button>
          <a href="/faktur?tipe=<%= tipe %>" class="btn" style="background:#95a5a6;color:#fff;">Reset</a>
        </div>
        <p style="font-size:12px; color:#7f8c8d; margin-bottom:16px;">
          Tips: pakai <code>%</code> sebagai wildcard. Contoh: <code>%1000236</code> = akhiri dengan 1000236, <code>INV%</code> = mulai dengan INV, <code>%123%</code> = mengandung 123.
        </p>
      </form>
    </div>

    <form method="GET" action="/faktur/export">
      <input type="hidden" name="tipe" value="<%= tipe %>">
      <div class="card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
          <h3 style="margin:0;">Daftar Faktur</h3>
          <button type="submit" class="btn btn-success">Export CSV CoreTax</button>
        </div>

        <div class="table-responsive" style="max-height: 450px; overflow-y: auto;">
          <table>
            <thead>
              <tr>
                <th><input type="checkbox" id="selectAll" title="Pilih semua"></th>
                <th>Nomor Faktur</th>
                <th>Tanggal</th>
                <th><%= config.partnerLabel %></th>
                <th>NPWP</th>
                <th>Kota</th>
                <th>Total</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% if (fakturList.length === 0) { %>
                <tr>
                  <td colspan="8" class="empty-state">Tidak ada data faktur</td>
                </tr>
              <% } else { %>
                <% fakturList.forEach(function(f) { %>
                  <tr>
                    <td><input type="checkbox" name="ids" value="<%= f.c_invoice_id %>"></td>
                    <td><%= f.nomor_faktur %></td>
                    <td><%= f.tanggal ? new Date(f.tanggal).toLocaleDateString('id-ID') : '-' %></td>
                    <td><%= f.partner_name %></td>
                    <td><%= f.npwp || '-' %></td>
                    <td><%= f.kota || '-' %></td>
                    <td><%= f.total ? parseFloat(f.total).toLocaleString('id-ID') : '0' %></td>
                    <td><%= f.status_label %></td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </form>
  </div>

  <div class="footer">
    CoreTax e-Faktur App &copy; <%= new Date().getFullYear() %>
  </div>

  <script>
    document.getElementById('selectAll').addEventListener('change', function(e) {
      const checkboxes = document.querySelectorAll('input[name="ids"]');
      checkboxes.forEach(cb => cb.checked = e.target.checked);
    });
  </script>
</body>
</html>
