# Koneksi ke PostgreSQL Adempiere (DB container expose port 5432 ke host)
CORETAX_DB_HOST=localhost
CORETAX_DB_PORT=5432
CORETAX_DB_NAME=adempiere
CORETAX_DB_USER=adempiere
CORETAX_DB_PASSWORD=adempiere

# App
CORETAX_APP_PORT=3000
CORETAX_SESSION_SECRET=ubah-ini-dengan-secret-yang-kuat

# Konfigurasi kolom NPWP (default: taxid di c_bpartner)
# Bisa juga pakai kolom custom, misal: npwp, taxid_npwp, duns, dll
CORETAX_NPWP_COLUMN=taxid
