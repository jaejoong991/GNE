# ==========================================
# KONFIGURASI KEAMANAN (WAJIB DIUBAH)
# ==========================================

# Session secret WAJIB diubah ke string random yang kuat (min 32 karakter)
# Bisa generate pakai: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CORETAX_SESSION_SECRET=GANTI-INI-DENGAN-SECRET-RANDOM-MINIMAL-32-KARAKTER

# ==========================================
# KONEKSI DATABASE ADEMPIERE
# ==========================================
CORETAX_DB_HOST=localhost
CORETAX_DB_PORT=5432
CORETAX_DB_NAME=adempiere
CORETAX_DB_USER=adempiere
CORETAX_DB_PASSWORD=adempiere

# ==========================================
# APP SETTING
# ==========================================
CORETAX_APP_PORT=3000

# ==========================================
# KONFIGURASI NPWP / TAX ID
# ==========================================
# Kolom sumber NPWP di tabel c_bpartner
# Bisa pakai kolom custom, misal: npwp, taxid_npwp, duns, dll
CORETAX_NPWP_COLUMN=taxid

# ==========================================
# ROLE ACCESS CONTROL
# ==========================================
# Daftar role Adempiere yang boleh login ke app ini.
# Pisahkan dengan koma. Kosongkan = semua role boleh login.
# Contoh: GardenAdmin,SystemAdministrator
# Contoh pakai Role ID: 1000000,1000001
# ALLOWED ROLE Accounting,Accounting & Finance Manager,Finance Manager,Finance Piutang, Accounting Supervisor, Finance Supervisor
CORETAX_ALLOWED_ROLES=
